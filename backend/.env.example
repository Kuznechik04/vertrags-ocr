# Kopieren nach `.env` und anpassen
DATABASE_URL=sqlite:///./vertrags_ocr.db
UPLOAD_DIR=./data/uploads

# "mock" (sofort lauffähig, regelbasiert) oder "donut" (fine-getuntes Modell)
OCR_BACKEND=mock
MODEL_PATH=../training/output/contract-donut

# Nur relevant für OCR_BACKEND=mock, bei gescannten PDFs/Bild-Uploads:
# "easyocr" (Standard, kein natives Programm nötig) oder "tesseract"
# (braucht lokal installiertes tesseract-Kommandozeilenprogramm)
MOCK_OCR_ENGINE=easyocr

FRONTEND_ORIGIN=http://localhost:5173

# Auth: zufälligen Wert generieren, z.B. mit
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=bitte-aendern-vor-produktivbetrieb
ACCESS_TOKEN_EXPIRE_MINUTES=1440
