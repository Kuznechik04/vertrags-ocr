# Kopieren nach `.env` und anpassen

# "development" (Standard) oder "production". In "production" verweigert die
# App den Start, falls SECRET_KEY noch der unsichere Default-Wert ist, und
# die hartcodierten localhost-CORS-Origins werden nicht mehr akzeptiert.
ENVIRONMENT=development

DATABASE_URL=sqlite:///./vertrags_ocr.db
UPLOAD_DIR=./data/uploads
# Maximale Upload-Größe in MB
MAX_UPLOAD_SIZE_MB=25

# "mock" (sofort lauffähig, regelbasiert) oder "donut" (fine-getuntes Modell)
OCR_BACKEND=mock
MODEL_PATH=../training/output/contract-donut

# Nur relevant für OCR_BACKEND=mock:
# Bei true OCR für jeden Upload verwenden. false nutzt zuerst PDF-Text und
# startet OCR nur als Fallback (bisheriges Verhalten).
MOCK_OCR_ALWAYS=true
# OCR-Engine für Scans/Bilder bzw. bei MOCK_OCR_ALWAYS=true für alle Uploads:
# "doctr" (Standard, kein natives Programm nötig, beste Genauigkeit bei
# gedrucktem Text), "easyocr" (ebenfalls kein natives Programm, aber
# schwächer bei dichtem Fließtext) oder "tesseract" (braucht lokal
# installiertes tesseract-Kommandozeilenprogramm)
MOCK_OCR_ENGINE=tesseract

FRONTEND_ORIGIN=http://localhost:5173

# Auth: zufälligen Wert generieren, z.B. mit
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=bitte-aendern-vor-produktivbetrieb
ACCESS_TOKEN_EXPIRE_MINUTES=1440
